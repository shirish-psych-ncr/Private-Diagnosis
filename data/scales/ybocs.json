    "adult",
    "older"
  ],
  "administeredBy": "clinician",
  "matrixOptions": [
    {
      "v": 0,
      "label": "0 - None / complete control"
    },
    {
      "v": 1,
      "label": "1 - Mild"
    },
    {
      "v": 2,
      "label": "2 - Moderate"
    },
    {
      "v": 3,
      "label": "3 - Severe"
    },
    {
      "v": 4,
      "label": "4 - Extreme / no control"
    }
  ],
  "parts": [
