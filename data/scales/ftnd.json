              "label": "21–30"
            },
            {
              "v": 3,
              "label": "31 or more"
            }
          ]
        },
        {
          "id": "ftnd_5",
          "text": "Do you smoke more frequently in the morning?",
          "scale": [
            {
              "v": 1,
              "label": "Yes"
            },
            {
              "v": 0,
              "label": "No"
            }
          ]
        },
        {
          "id": "ftnd_6",
          "text": "Do you smoke even if you are so ill that you are in bed most of the day?",
          "scale": [
            {
              "v": 1,
              "label": "Yes"
            },
            {
              "v": 0,
              "label": "No"
            }
          ]
        }
