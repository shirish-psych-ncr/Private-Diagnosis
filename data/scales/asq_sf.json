        },
        {
          "id": "asq_sf_17",
          "itemNumber": "17",
          "text": "I worry that others won't care about me as much as I care about them"
        },
        {
          "id": "asq_sf_18",
          "itemNumber": "18",
          "text": "I worry about people getting too close"
        },
        {
          "id": "asq_sf_19",
          "itemNumber": "19",
          "text": "I worry that I won't measure up to other people"
        },
        {
          "id": "asq_sf_20",
          "itemNumber": "20",
          "text": "I have mixed feelings about being close to others"
        },
        {
          "id": "asq_sf_21",
          "itemNumber": "21",
          "text": "I wonder why people would want to be involved with me"
        },
        {
          "id": "asq_sf_22",
          "itemNumber": "22",
          "text": "I worry a lot about my relationships"
        },
        {
          "id": "asq_sf_23",
          "itemNumber": "23",
          "text": "I wonder how I would cope without someone to love me"
        },
        {
          "id": "asq_sf_24",
          "itemNumber": "24",
          "text": "I feel confident about relating to others"
        },
        {
          "id": "asq_sf_25",
          "itemNumber": "25",
          "text": "I often feel left out or alone"
        },
        {
          "id": "asq_sf_26",
          "itemNumber": "26",
          "text": "I often worry that I do not really fit in with other people (Reverse Scored)",
          "reverse": true
        },
        {
          "id": "asq_sf_27",
          "itemNumber": "27",
          "text": "Other people have their own problems, so I don't bother them with mine"
        },
        {
          "id": "asq_sf_28",
          "itemNumber": "28",
          "text": "If something is bothering me, others are generally aware and concerned"
        },
        {
