        {
          "id": "asq_sf_1",
          "itemNumber": "1",
          "text": "I feel confident that other people will be there for me when I need them"
        },
        {
          "id": "asq_sf_2",
          "itemNumber": "2",
          "text": "I prefer to depend on myself rather than other people"
        },
        {
          "id": "asq_sf_3",
          "itemNumber": "3",
          "text": "I prefer to keep to myself"
        },
        {
          "id": "asq_sf_4",
          "itemNumber": "4",
          "text": "Achieving things is more important than building relationships"
        },
        {
          "id": "asq_sf_5",
          "itemNumber": "5",
          "text": "Doing your best is more important than getting on with others"
        },
        {
          "id": "asq_sf_6",
          "itemNumber": "6",
          "text": "If you've got a job to do, you should do it no matter who gets hurt"
        },
        {
          "id": "asq_sf_7",
          "itemNumber": "7",
          "text": "It's important to me that others like me"
        },
        {
          "id": "asq_sf_8",
          "itemNumber": "8",
          "text": "I find it hard to make a decision unless I know what other people think"
        },
        {
