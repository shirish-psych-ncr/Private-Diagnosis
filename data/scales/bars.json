    },
    {
      "v": 1,
      "label": "1 - Characteristic restless movements for less than half the observation"
    },
    {
      "v": 2,
      "label": "2 - Characteristic restless movements for at least half the observation"
    },
    {
      "v": 3,
      "label": "3 - Constant restless movements / cannot remain seated or standing"
    }
  ],
