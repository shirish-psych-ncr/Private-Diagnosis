{
  "id":"bai","name":"Beck Anxiety Inventory (BAI)",
  "directions":"Self-report. Indicate how much each symptom bothered you during the past month, including today. 0 not at all; 1 mildly; 2 moderately; 3 severely.",
  "ageGroups":["adult","older"],"administeredBy":"self-report",
